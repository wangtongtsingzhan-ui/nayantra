{
  "name": "Gazebo 仓库 + Nav2",
  "description": "Gazebo Harmonic 仓库中的 3 台清湛 UGV，各自使用 /ugv_01、/ugv_02 和 /ugv_03 下的 Nav2 栈（bash scripts/run_gazebo.sh sim）。核心服务的 Shell 需加载 ROS 2 并使用相同的 ROS_DOMAIN_ID。",
  "maps": [
    "../maps/gazebo_warehouse.json"
  ],
  "fleets": [
    {
      "id": "gazebo_fleet",
      "name": "tsingbot UGV 车队（Nav2）",
      "robot_type": "ugv",
      "description": "Gazebo 仓库中的清湛差速 UGV，通过 Nav2（ROS 2 Humble 或 Jazzy）控制。",
      "color": "#f5a623",
      "capabilities": [
        "navigate",
        "carry_payload",
        "patrol",
        "dock",
        "charge"
      ],
      "navigation": {
        "stack": "nav2",
        "planner": "navfn (A*)",
        "controller": "regulated_pure_pursuit",
        "localization": "none"
      },
      "footprint": {
        "shape": "circle",
        "radius": 0.45
      },
      "limits": {
        "max_speed": 0.5,
        "max_accel": 0.5,
        "max_decel": 1.0,
        "max_yaw_rate": 1.5
      },
      "battery": {
        "min_pct": 0,
        "recharge_pct": 0,
        "drain_pct_per_min_idle": 0,
        "drain_pct_per_m": 0
      },
      "charging_required": false,
      "map_ids": [
        "gazebo_warehouse"
      ],
      "layer": "ground",
      "communication": {
        "protocol": "ros2",
        "namespace": ""
      },
      "priority": 5
    }
  ],
  "robots": [
    {
      "id": "ugv_01",
      "name": "tsingbot UGV-01",
      "fleet_id": "gazebo_fleet",
      "manufacturer": "清湛机器人",
      "model": "清湛 UGV（Gazebo 仿真）",
      "navigation": {
        "map_id": "gazebo_warehouse",
        "namespace": "ugv_01",
        "frame": "map",
        "base_frame": "base_link",
        "odom_source": "odom",
        "sensors": [
          "lidar_2d"
        ]
      },
      "physical": {
        "payload_kg": 50,
        "turning_radius": 0.0
      },
      "spawn": {
        "waypoint_id": "recv_dock",
        "battery_pct": 100
      }
    },
    {
      "id": "ugv_02",
      "name": "tsingbot UGV-02",
      "fleet_id": "gazebo_fleet",
      "manufacturer": "清湛机器人",
      "model": "清湛 UGV（Gazebo 仿真）",
      "navigation": {
        "map_id": "gazebo_warehouse",
        "namespace": "ugv_02",
        "frame": "map",
        "base_frame": "base_link",
        "odom_source": "odom",
        "sensors": [
          "lidar_2d"
        ]
      },
      "physical": {
        "payload_kg": 50,
        "turning_radius": 0.0
      },
      "spawn": {
        "waypoint_id": "ship_dock",
        "battery_pct": 100
      }
    },
    {
      "id": "ugv_03",
      "name": "tsingbot UGV-03",
      "fleet_id": "gazebo_fleet",
      "manufacturer": "清湛机器人",
      "model": "清湛 UGV（Gazebo 仿真）",
      "navigation": {
        "map_id": "gazebo_warehouse",
        "namespace": "ugv_03",
        "frame": "map",
        "base_frame": "base_link",
        "odom_source": "odom",
        "sensors": [
          "lidar_2d"
        ]
      },
      "physical": {
        "payload_kg": 50,
        "turning_radius": 0.0
      },
      "spawn": {
        "waypoint_id": "charger",
        "battery_pct": 100
      }
    }
  ]
}
